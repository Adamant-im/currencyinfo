{
  "name": "currencyinfo",
  "version": "4.2.0",
  "description": "Self-hosted crypto and fiat currency rates service provider",
  "author": "ADAMANT community developers <devs@adamant.im>, ADAMANT Foundation <devs@adamant.im>",
  "private": true,
  "license": "GPL-3.0",
  "scripts": {
    "build": "nest build",
    "migrate": "node scripts/migrate.mjs",
    "migrate-db": "node scripts/migrate-db.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "deps:setup": "pnpm rebuild @swc/core"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/mongoose": "^11.0.1",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/schedule": "^6.0.0",
    "adamant-api": "^3.1.0",
    "axios": "^1.8.1",
    "chalk": "^4.1.2",
    "json5": "^2.2.3",
    "mongoose": "^8.12.1",
    "ms": "^2.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.0.11",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "prettier": "^3.5.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.26.10",
      "@babel/helpers": "^7.26.10",
      "brace-expansion": "^2.0.2",
      "braces": "^3.0.3",
      "cipher-base": "^1.0.6",
      "cross-spawn": "^7.0.6",
      "diff": "^5.2.0",
      "elliptic": "^6.6.1",
      "flatted": "^3.3.3",
      "js-yaml": "^4.3.1",
      "lodash": "^4.18.1",
      "micromatch": "^4.0.8",
      "minimatch": "^9.0.7",
      "nanoid": "^3.3.8",
      "path-to-regexp": "^8.4.2",
      "picomatch": "^2.3.2",
      "sha.js": "^2.4.12",
      "socket.io-parser": "^4.2.7"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "modulePaths": [
      "<rootDir>"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/main.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  },
  "keywords": [
    "adamant",
    "adm",
    "currencyinfo",
    "blockchain",
    "bitcoin",
    "ethereum",
    "trading",
    "trade",
    "exchange",
    "exchange-rates",
    "crypto",
    "cryptocurrency",
    "fiat",
    "rates-provider",
    "coingecko",
    "coinmarketcap",
    "cryptocompare",
    "currency-api",
    "moex",
    "exchangerate-host",
    "ticker",
    "rate",
    "money",
    "usd",
    "eur",
    "cny",
    "jpy",
    "rub",
    "btc",
    "eth",
    "nestjs",
    "typescript",
    "mongodb",
    "self-hosted",
    "decentralization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adamant-im/currencyinfo.git"
  },
  "bugs": {
    "url": "https://github.com/Adamant-im/currencyinfo/issues"
  },
  "homepage": "https://github.com/Adamant-im/currencyinfo#readme"
}
