{
  "name": "currencyinfo",
  "version": "4.2.0",
  "description": "Universal self-hosted crypto and fiat exchange rates service aggregating multiple sources behind one REST API",
  "author": "ADAMANT community developers <devs@adamant.im>, ADAMANT Foundation <devs@adamant.im>",
  "private": true,
  "license": "GPL-3.0",
  "scripts": {
    "build": "nest build",
    "migrate": "node scripts/migrate.mjs",
    "migrate-db": "node scripts/migrate-db.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.mjs\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "deps:setup": "pnpm rebuild @swc/core",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:links": "node scripts/check-docs-links.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "adamant-api": "^3.1.0",
    "axios": "^1.20.0",
    "chalk": "^6.0.0",
    "json5": "^2.2.3",
    "mongoose": "^9.9.5",
    "ms": "^2.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitepress": "2.0.0-alpha.20"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "modulePaths": [
      "<rootDir>"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/main.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  },
  "keywords": [
    "adamant",
    "adm",
    "currencyinfo",
    "blockchain",
    "bitcoin",
    "ethereum",
    "trading",
    "trade",
    "exchange",
    "exchange-rates",
    "crypto",
    "crypto-rates",
    "cryptocurrency",
    "fiat",
    "fiat-currency",
    "forex",
    "market-data",
    "price-aggregation",
    "multi-source",
    "historical-data",
    "rates-provider",
    "coingecko",
    "coinmarketcap",
    "coinpaprika",
    "coinlore",
    "binance",
    "cryptocompare",
    "currency-api",
    "moex",
    "exchangerate-host",
    "exchangerate-api",
    "ticker",
    "rate",
    "money",
    "usd",
    "eur",
    "cny",
    "jpy",
    "rub",
    "btc",
    "eth",
    "nestjs",
    "typescript",
    "mongodb",
    "docker",
    "self-hosted",
    "decentralization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adamant-im/currencyinfo.git"
  },
  "bugs": {
    "url": "https://github.com/Adamant-im/currencyinfo/issues"
  },
  "homepage": "https://currencyinfo.dev"
}
